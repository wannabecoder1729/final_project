"""
emotion_detection.py

This module defines the emotion_detector function, which sends text to the
IBM Watson NLP EmotionPredict service, parses the response, formats the
output, and handles blank/invalid input gracefully.
"""

import json
import requests


def emotion_detector(text_to_analyze):
    """
    Sends text_to_analyze to the Watson NLP EmotionPredict service and
    returns a dictionary containing the scores for anger, disgust, fear,
    joy, sadness, and the dominant emotion.

    If the input text is blank (or the service returns a 400 status code),
    all values in the returned dictionary are set to None.
    """
    url = ('https://sn-watson-emotion.labs.skills.network/v1/'
           'watson.runtime.nlp.v1/NlpService/EmotionPredict')

    myobj = {"raw_document": {"text": text_to_analyze}}

    header = {
        "grpc-metadata-mm-model-id": "emotion_aggregated-workflow_lang_en_stock"
    }

    response = requests.post(url, json=myobj, headers=header, timeout=10)

    # Task 7 - Activity 1: handle blank input / server error (status 400)
    if response.status_code == 400:
        return {
            'anger': None,
            'disgust': None,
            'fear': None,
            'joy': None,
            'sadness': None,
            'dominant_emotion': None
        }

    formatted_response = json.loads(response.text)
    emotion_predictions = formatted_response['emotionPredictions'][0]['emotion']

    anger = emotion_predictions['anger']
    disgust = emotion_predictions['disgust']
    fear = emotion_predictions['fear']
    joy = emotion_predictions['joy']
    sadness = emotion_predictions['sadness']

    emotions_scored = {
        'anger': anger,
        'disgust': disgust,
        'fear': fear,
        'joy': joy,
        'sadness': sadness
    }

    # Task 3 - Activity 1: determine the dominant emotion
    dominant_emotion = max(emotions_scored, key=emotions_scored.get)

    final_output = {
        'anger': anger,
        'disgust': disgust,
        'fear': fear,
        'joy': joy,
        'sadness': sadness,
        'dominant_emotion': dominant_emotion
    }

    return final_output

